# Copy to .env.local. Every value is optional: without Supabase the dashboard
# still runs on simulated data and USB devices.

# Public site URL (used for Open Graph images).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (Project Settings > API Keys).
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...). Legacy name NEXT_PUBLIC_SUPABASE_ANON_KEY also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...), server-only: irrigation writes and rain sync.
# Legacy name SUPABASE_SERVICE_ROLE_KEY also works. Never expose it to the browser.
SUPABASE_SECRET_KEY=

# Only for `npm run supabase:copy` (docs/data.md).
OLD_SUPABASE_URL=
OLD_SUPABASE_KEY=
NEW_SUPABASE_URL=
NEW_SUPABASE_SECRET_KEY=
